{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TuringMachineSpecification",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "machine_type",
    "states",
    "input_alphabet",
    "tape_alphabet",
    "blank_symbol",
    "start_state",
    "accept_states",
    "reject_states",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "machine_type": {
      "type": "string",
      "enum": ["deterministic_single_tape"]
    },
    "states": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "input_alphabet": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "tape_alphabet": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "blank_symbol": {
      "type": "string",
      "minLength": 1
    },
    "start_state": {
      "type": "string"
    },
    "accept_states": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reject_states": {
      "type": "array",
      "items": { "type": "string" }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "read", "write", "move", "next_state"],
        "properties": {
          "state": { "type": "string" },
          "read": { "type": "string" },
          "write": { "type": "string" },
          "move": { "type": "string", "enum": ["L", "R", "S"] },
          "next_state": { "type": "string" }
        }
      }
    }
  }
}
